{
  "schema": "avm-proofpack-settlement-evidence-binding/v1",
  "artefact_id": "settlement-evidence-binding-conformance-v1",
  "published_at": "2026-08-02T00:00:00Z",
  "canon_note": "bundle_sha256 = SHA-256( json.dumps(bundle, indent=2, sort_keys=True) + '\\n' ) -- the bytes avm_proofpack.dump_bundle writes. This is NOT RFC 8785 JCS; it is chosen so a downloaded .proofpack.json verifies with plain sha256sum. attestation_content_hash IS JCS (RFC 8785), the same as settlement_attestation_v1. The two canons deliberately differ; see seb-v1-r05 (canary).",
  "load_bearing_rules": {
    "R1": "bundle_sha256 == SHA-256(dump_bundle bytes); NOT JCS.",
    "R2": "settled_payment_ref == 'sha256:'+SHA-256(f'{tenant_id}:{tx_id}:{network}').",
    "R3": "round == bundle.round == attestation_settlement_round (L2 join).",
    "R4": "chain_genesis_id == bundle.genesis_id (chain-identity pin).",
    "R5": "bundle verifies under avm_proofpack.verify_bundle (real anchor)."
  },
  "composes_with": {
    "raw_bundle_set": "../positive, ../negative (the on-chain anchor + its 17 tamper negatives)",
    "settlement_attestation": "algovoi-jcs-conformance-vectors settlement_attestation_v1 (round-bearing vector settlement-attestation-v1-009) and settlement_action_binding_v1 (sab-v1-007)"
  },
  "vectors": [
    {
